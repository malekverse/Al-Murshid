{
  "name": "al-murshid",
  "private": true,
  "packageManager": "pnpm@10.14.0",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=@murshid/web",
    "dev:mobile": "pnpm --filter @murshid/mobile start",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "i18n:check": "pnpm --filter @murshid/i18n check",
    "tokens:check": "pnpm --filter @murshid/tokens check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "content:check": "pnpm --filter @murshid/content quran:check"
  },
  "devDependencies": {
    "prettier": "3.9.10",
    "turbo": "2.11.9"
  }
}
