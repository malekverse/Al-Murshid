<?xml version="1.0" encoding="utf-8"?>
<!-- The widget picker's preview: the widget's own layout with a sample evening. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/prayer_widget_root"
  android:layout_width="match_parent"
  android:layout_height="match_parent">
  <ImageView
    android:id="@+id/prayer_widget_sky"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:importantForAccessibility="no"
    android:scaleType="fitXY"
    android:src="@drawable/prayer_widget_sky_default" />
  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:padding="@dimen/prayer_widget_padding">
    <LinearLayout
      android:layout_width="0dp"
      android:layout_height="match_parent"
      android:layout_weight="1"
      android:gravity="center_vertical"
      android:orientation="vertical">
      <TextView
        android:id="@+id/prayer_widget_label"
        android:text="@string/prayer_widget_small_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:ellipsize="end"
        android:textAlignment="viewStart"
        android:textColor="@color/prayer_widget_muted"
        android:textSize="13sp" />
      <TextView
        android:id="@+id/prayer_widget_name"
        android:text="@string/prayer_widget_sample_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:ellipsize="end"
        android:textAlignment="viewStart"
        android:textColor="@color/prayer_widget_ink"
        android:textSize="26sp"
        android:textStyle="bold" />
      <TextView
        android:id="@+id/prayer_widget_time"
        android:text="@string/prayer_widget_sample_time"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="2"
        android:ellipsize="end"
        android:textAlignment="viewStart"
        android:textColor="@color/prayer_widget_ink"
        android:textSize="15sp" />
      <TextView
        android:id="@+id/prayer_widget_countdown"
        android:text="@string/prayer_widget_sample_countdown"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/prayer_widget_gap"
        android:maxLines="1"
        android:ellipsize="end"
        android:textAlignment="viewStart"
        android:textColor="@color/prayer_widget_accent"
        android:textSize="15sp" />
    </LinearLayout>
    <LinearLayout
      android:id="@+id/prayer_widget_rows"
      android:layout_width="0dp"
      android:layout_height="match_parent"
      android:layout_marginStart="@dimen/prayer_widget_padding"
      android:layout_weight="1"
      android:orientation="vertical">
      <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView
          android:id="@+id/prayer_widget_row0_name"
        android:text="@string/prayer_widget_sample_row0_name"
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_weight="1"
          android:maxLines="1"
          android:ellipsize="end"
          android:textAlignment="viewStart"
          android:textColor="@color/prayer_widget_ink"
          android:textSize="13sp" />
        <TextView
          android:id="@+id/prayer_widget_row0_time"
        android:text="@string/prayer_widget_sample_row0_time"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:maxLines="1"
          android:textAlignment="viewEnd"
          android:textColor="@color/prayer_widget_ink"
          android:textSize="13sp" />
      </LinearLayout>
      <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView
          android:id="@+id/prayer_widget_row1_name"
        android:text="@string/prayer_widget_sample_row1_name"
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_weight="1"
          android:maxLines="1"
          android:ellipsize="end"
          android:textAlignment="viewStart"
          android:textColor="@color/prayer_widget_ink"
          android:textSize="13sp" />
        <TextView
          android:id="@+id/prayer_widget_row1_time"
        android:text="@string/prayer_widget_sample_row1_time"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:maxLines="1"
          android:textAlignment="viewEnd"
          android:textColor="@color/prayer_widget_ink"
          android:textSize="13sp" />
      </LinearLayout>
      <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView
          android:id="@+id/prayer_widget_row2_name"
        android:text="@string/prayer_widget_sample_row2_name"
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_weight="1"
          android:maxLines="1"
          android:ellipsize="end"
          android:textAlignment="viewStart"
          android:textColor="@color/prayer_widget_ink"
          android:textSize="13sp" />
        <TextView
          android:id="@+id/prayer_widget_row2_time"
        android:text="@string/prayer_widget_sample_row2_time"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:maxLines="1"
          android:textAlignment="viewEnd"
          android:textColor="@color/prayer_widget_ink"
          android:textSize="13sp" />
      </LinearLayout>
      <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView
          android:id="@+id/prayer_widget_row3_name"
        android:text="@string/prayer_widget_sample_row3_name"
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_weight="1"
          android:maxLines="1"
          android:ellipsize="end"
          android:textAlignment="viewStart"
          android:textColor="@color/prayer_widget_ink"
          android:textSize="13sp" />
        <TextView
          android:id="@+id/prayer_widget_row3_time"
        android:text="@string/prayer_widget_sample_row3_time"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:maxLines="1"
          android:textAlignment="viewEnd"
          android:textColor="@color/prayer_widget_ink"
          android:textSize="13sp" />
      </LinearLayout>
      <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView
          android:id="@+id/prayer_widget_row4_name"
        android:text="@string/prayer_widget_sample_row4_name"
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_weight="1"
          android:maxLines="1"
          android:ellipsize="end"
          android:textAlignment="viewStart"
          android:textColor="@color/prayer_widget_accent"
          android:textStyle="bold"
          android:textSize="13sp" />
        <TextView
          android:id="@+id/prayer_widget_row4_time"
        android:text="@string/prayer_widget_sample_row4_time"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:maxLines="1"
          android:textAlignment="viewEnd"
          android:textColor="@color/prayer_widget_accent"
          android:textStyle="bold"
          android:textSize="13sp" />
      </LinearLayout>
    </LinearLayout>
  </LinearLayout>
</FrameLayout>
