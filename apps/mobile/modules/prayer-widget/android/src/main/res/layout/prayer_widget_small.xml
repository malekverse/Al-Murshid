<?xml version="1.0" encoding="utf-8"?>
<!-- Drawn by PrayerWidgets.kt: the sky behind, the next prayer and the time left on top. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/prayer_widget_root"
  android:layout_width="match_parent"
  android:layout_height="match_parent">
  <ImageView
    android:id="@+id/prayer_widget_sky"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:importantForAccessibility="no"
    android:scaleType="fitXY"
    android:src="@drawable/prayer_widget_sky_default" />
  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:padding="@dimen/prayer_widget_padding">
    <LinearLayout
      android:layout_width="0dp"
      android:layout_height="match_parent"
      android:layout_weight="1"
      android:gravity="center_vertical"
      android:orientation="vertical">
      <TextView
        android:id="@+id/prayer_widget_label"
        android:text="@string/prayer_widget_small_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:ellipsize="end"
        android:textAlignment="viewStart"
        android:textColor="@color/prayer_widget_muted"
        android:textSize="13sp" />
      <TextView
        android:id="@+id/prayer_widget_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:ellipsize="end"
        android:textAlignment="viewStart"
        android:textColor="@color/prayer_widget_ink"
        android:textSize="26sp"
        android:textStyle="bold" />
      <TextView
        android:id="@+id/prayer_widget_time"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="2"
        android:ellipsize="end"
        android:textAlignment="viewStart"
        android:textColor="@color/prayer_widget_ink"
        android:textSize="15sp" />
      <TextView
        android:id="@+id/prayer_widget_countdown"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/prayer_widget_gap"
        android:maxLines="1"
        android:ellipsize="end"
        android:textAlignment="viewStart"
        android:textColor="@color/prayer_widget_accent"
        android:textSize="15sp" />
    </LinearLayout>
  </LinearLayout>
</FrameLayout>
