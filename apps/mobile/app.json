{
  "expo": {
    "name": "Al-Murshid",
    "slug": "al-murshid",
    "version": "0.1.0",
    "scheme": "almurshid",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#F7F4EE",
    "ios": {
      "bundleIdentifier": "com.malekverse.almurshid",
      "supportsTablet": true,
      "infoPlist": {
        "CFBundleLocalizations": ["ar", "en", "fr"],
        "CFBundleDevelopmentRegion": "ar"
      }
    },
    "android": {
      "package": "com.malekverse.almurshid",
      "adaptiveIcon": {
        "backgroundColor": "#1E2A4A",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": true,
      "permissions": ["android.permission.SCHEDULE_EXACT_ALARM"]
    },
    "plugins": [
      "expo-router",
      "expo-localization",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120,
          "backgroundColor": "#F7F4EE",
          "dark": {
            "image": "./assets/images/splash-icon.png",
            "backgroundColor": "#0E1116"
          }
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#BB7E25",
          "sounds": ["./assets/sounds/soft_tone.wav"],
          "enableRemoteNotifications": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Al-Murshid uses your location to calculate prayer times and the Qibla. It stays on your device."
        }
      ],
      "expo-sqlite",
      "expo-background-task",
      [
        "expo-build-properties",
        {
          "android": {
            "extraProguardRules": "# WorkManager (used by expo-notifications and expo-background-task) creates its Room database\n# through reflection; R8 must keep the generated implementation or release builds crash at start.\n-keep class * extends androidx.room.RoomDatabase { <init>(); }\n-keep class androidx.work.impl.WorkDatabase_Impl { *; }"
          }
        }
      ],
      "./plugins/with-short-native-build-paths"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
