{
  "expo": {
    "name": "Al-Murshid",
    "slug": "al-murshid",
    "version": "0.1.0",
    "scheme": "almurshid",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#F7F4EE",
    "ios": {
      "bundleIdentifier": "com.malekverse.almurshid",
      "icon": {
        "light": "./assets/images/icon.png",
        "dark": "./assets/images/icon-dark.png",
        "tinted": "./assets/images/icon-tinted.png"
      },
      "supportsTablet": true,
      "infoPlist": {
        "CFBundleLocalizations": ["ar", "en", "fr"],
        "CFBundleDevelopmentRegion": "ar"
      }
    },
    "android": {
      "package": "com.malekverse.almurshid",
      "adaptiveIcon": {
        "backgroundColor": "#1E2A4A",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": true,
      "permissions": ["android.permission.SCHEDULE_EXACT_ALARM"]
    },
    "plugins": [
      "expo-router",
      "expo-localization",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120,
          "backgroundColor": "#F7F4EE",
          "dark": {
            "image": "./assets/images/splash-icon.png",
            "backgroundColor": "#0E1116"
          }
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#BB7E25",
          "sounds": ["./assets/sounds/soft_tone.wav"],
          "enableRemoteNotifications": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Al-Murshid uses your location to calculate prayer times and the Qibla. It stays on your device."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": true
        }
      ],
      "expo-sqlite",
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Al-Murshid asks for Face ID to unlock You, where your reflections are kept."
        }
      ],
      "expo-background-task",
      [
        "expo-build-properties",
        {
          "android": {
            "extraProguardRules": "# WorkManager (used by expo-notifications and expo-background-task) creates its Room database\n# through reflection; R8 must keep the generated implementation or release builds crash at start.\n-keep class * extends androidx.room.RoomDatabase { <init>(); }\n-keep class androidx.work.impl.WorkDatabase_Impl { *; }"
          }
        }
      ],
      "./plugins/with-local-cleartext",
      "./plugins/with-short-native-build-paths",
      "expo-sharing",
      [
        "expo-camera",
        {
          "cameraPermission": "Al-Murshid uses the camera only for Fajr Rise, to scan your spot or count squats. Nothing is recorded or sent.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "./modules/fajr-rise/app.plugin.js",
        {
          "alarmKitUsage": "Al-Murshid rings Fajr Rise, the alarm you set for Fajr, even in silent mode."
        }
      ],
      [
        "expo-sensors",
        {
          "motionPermission": "Al-Murshid counts your steps only to stop the Fajr Rise alarm. Nothing is recorded."
        }
      ],
      [
        "expo-widgets",
        {
          "groupIdentifier": "group.com.malekverse.almurshid",
          "bundleIdentifier": "com.malekverse.almurshid.ExpoWidgetsTarget",
          "widgets": [
            {
              "name": "PrayerWidget",
              "displayName": "Al-Murshid",
              "description": "The next prayer and the time left.",
              "ios": {
                "supportedFamilies": [
                  "systemSmall",
                  "systemMedium",
                  "accessoryRectangular",
                  "accessoryInline"
                ]
              }
            }
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
